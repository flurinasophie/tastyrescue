
# Copy this file to .env and fill in the values from the lecture slides.
# .env is in .gitignore, so the password never lands on GitHub.
DB_USER=trengineer
DB_PASSWORD=tr123
DB_HOST=database-1.c32ikym4q9dx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
# Our own schema, so we never touch other teams' tables on the shared database
DB_SCHEMA=tastyrescue

# Part 03: which Postgres the scripts talk to by default - "rds" (the shared
# course server in Singapore) or "local" (docker compose db on :5434). Most
# scripts also take --db rds|local to override this per run.
DB_TARGET=rds
LOCAL_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/tastyrescue

# Part 03: Redis (docker compose redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
OFFER_CACHE_TTL_SECONDS=30
